# =============================================================================
# StonkPit — safe defaults for GitHub (no secrets, no ledger, no keypairs)
# =============================================================================

# --- Dependencies ---
node_modules/

# --- Next.js ---
.next/
out/

# --- Environment & secrets (NEVER commit) ---
.env
.env.*
!.env.example

# --- Wallet / key material ---
keys/
*.pem
*.key
id.json
*-keypair.json
wallet.json
**/treasury.json
**/admin.json
**/program.json

# --- Local database / ledger (wallets, deposits, rooms) ---
data/*
!data/.gitkeep

# --- Solana / Anchor / Rust ---
.anchor/
target/
**/*.rs.bk
test-ledger/
.validator/
.surfpool/

# --- Build / cache ---
dist/
.turbo/
*.tsbuildinfo
.eslintcache

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
.cursor/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
