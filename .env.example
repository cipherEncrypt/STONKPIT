# Copy to .env and fill in your values (never commit .env)
#   cp .env.example .env

# Local dev: omit DATABASE_URL to use data/stonkpit.json
# Production (Vercel + Render Postgres): use Render pooler URL, SSL on
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Solana mainnet RPC (server + browser via /api/config). Pick one:
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# ALCHEMY_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Treasury USDC receive address (public pubkey only — NOT the private key)
TREASURY_USDC_ADDRESS=YOUR_TREASURY_WALLET_PUBKEY
NEXT_PUBLIC_TREASURY_USDC_ADDRESS=YOUR_TREASURY_WALLET_PUBKEY

# Site URL for API CORS (Vercel production domain)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# ALLOWED_ORIGIN=https://your-app.vercel.app

# Never commit — admin withdraw script only (base58 secret key)
# TREASURY_PRIVATE_KEY=

# Fight length — keep server + client in sync (3 min)
ROOM_DURATION=180
NEXT_PUBLIC_ROOM_DURATION=180

# JSON ledger path (default: ./data/stonkpit.json — gitignored)
# DATABASE_PATH=./data/stonkpit.json

# Pyth Hermes — required for live prices (public Hermes returns 401 without a key)
# https://docs.pyth.network/price-feeds/core/fetch-price-updates
PYTH_API_KEY=YOUR_PYTH_API_KEY
# Optional Hermes base URL (default https://hermes.pyth.network)
# PYTH_HERMES_URL=
# Log chosen feed per fetch: PYTH_LOG=1