# Copy to .env and fill in your values (never commit .env)
#   cp .env.example .env

# Alchemy Solana mainnet — server + wallet (served to browser via /api/config)
# Dashboard: https://dashboard.alchemy.com → Apps → Solana → Mainnet
ALCHEMY_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Treasury USDC receive address (public pubkey only — NOT the private key)
TREASURY_USDC_ADDRESS=YOUR_TREASURY_WALLET_PUBKEY

# Never commit — admin withdraw script only (base58 secret key)
# TREASURY_PRIVATE_KEY=

# Room timer in seconds (60 for demo filming)
ROOM_DURATION=60

# JSON ledger path (default: ./data/stonkpit.json — gitignored)
# DATABASE_PATH=./data/stonkpit.json

# Optional Pyth Hermes key
# PYTH_API_KEY=
